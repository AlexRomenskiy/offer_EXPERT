{
  "headers": [
    { "source": "/origin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/origin/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "rewrites": [
    { "source": "/origin", "destination": "/origin/index.html" },
    { "source": "/origin/", "destination": "/origin/index.html" },
    { "source": "/origin/kit", "destination": "/origin/kit/index.html" },
    { "source": "/origin/kit/", "destination": "/origin/kit/index.html" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
